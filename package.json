{
  "name": "v-lab-ece",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "jest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate-experiments": "tsx scripts/validate-experiments.ts",
    "check:vercel-json": "tsx scripts/check-vercel-json.ts",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:deploy-size": "node scripts/check-deploy-size.mjs",
    "check:no-test-hooks": "node scripts/check-no-test-hooks.mjs",
    "check:forbidden-patterns": "node scripts/check-forbidden-patterns.mjs",
    "check:no-code-eval-routes": "node scripts/check-no-code-eval-routes.mjs",
    "engine-pin-check": "node scripts/engine-pin-check.mjs",
    "ac-coverage": "tsx scripts/ac-coverage.ts",
    "verify": "turbo run typecheck && eslint . --max-warnings 0 && prettier --check . && jest && tsx scripts/ac-coverage.ts && node scripts/engine-pin-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@swc/core": "1.15.11",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "24.11.0",
    "eslint": "9.39.0",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.3",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "turbo": "2.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "zod": "3.25.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cypress",
      "es5-ext",
      "esbuild",
      "mongodb-memory-server"
    ]
  }
}
